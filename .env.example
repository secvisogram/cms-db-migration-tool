# Old CouchDB installation (read-only copy)
CSAF_COUCHDB_DATA_DIR=/path/to/old/couchdb/data
CSAF_COUCHDB_USER=admin
CSAF_COUCHDB_PASSWORD=admin
CSAF_COUCHDB_DBNAME=csaf

# Target PostgreSQL (the new CMS database, schema already created by the backend's first start).
# With the backend's docker/ stack, cms-db is published on the host port CSAF_DB_PORT.
CSAF_DB_HOST=host.docker.internal
CSAF_DB_PORT=5432
CSAF_DB_NAME=
CSAF_DB_USER=
CSAF_DB_PASSWORD=

# Optional: pin another tool image
# CSAF_MIGRATOR_IMAGE=ghcr.io/secvisogram/cms-db-migration-tool:1.0.3

# Required: image of the new backend (image of backend-cms in the backend's compose file)
CSAF_BACKEND_IMAGE=ghcr.io/secvisogram/csaf-cms-backend:feat-couchdb-to-postgres-migration